aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 16px; font-weight: 533.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><span role="status" class="sr-only"></span><div class="max-w-[85%]"></div></div></div></div></div></div></div><div data-rs-index="41" data-index="41" data-testid="transcript-row" data-last-message="true" data-perf-row="assistant" data-perf-row-from-tail="0" data-perf-row-streaming="false" style="display: flow-root; position: relative;" aria-hidden="true"><div role="article" tabindex="-1" class="rounded-lg focus-visible:shadow-focus focus-visible:outline-hidden" aria-setsize="42" aria-posinset="42" aria-label="Mensagem 42 de 42"><div data-test-render-count="1"><div class="group group/message-row"><div class="contents"><div class="group relative relative pb-[var(--msg-assistant-pb,0.75rem)]" style="" data-is-streaming="false"><h2 data-find-omitted="" class="sr-only select-none">Claude respondeu: Isso mesmo, você entendeu certo — mas vale destrinchar porque tem duas coisas acontecendo ali.</h2><div class="font-claude-response relative leading-[1.65rem] [&amp;_pre&gt;div]:bg-bg-000/50 [&amp;_pre&gt;div]:border-0.5 [&amp;_pre&gt;div]:border-border-400 [&amp;_.ignore-pre-bg&gt;div]:bg-transparent [&amp;_.standard-markdown_:is(p,blockquote,h1,h2,h3,h4,h5,h6)]:pl-[var(--msg-text-inset,0.5rem)] [&amp;_.standard-markdown_:is(p,blockquote,ul,ol,h1,h2,h3,h4,h5,h6)]:pr-8 [&amp;_.progressive-markdown_:is(p,blockquote,h1,h2,h3,h4,h5,h6)]:pl-[var(--msg-text-inset,0.5rem)] [&amp;_.progressive-markdown_:is(p,blockquote,ul,ol,h1,h2,h3,h4,h5,h6)]:pr-8 [&amp;_.md-table-scroll]:pl-[var(--msg-block-inset,0.5rem)] [&amp;_.md-table-scroll]:pr-[var(--msg-inset-end,0.5rem)]"><div class=""><div data-cds="Prose" class="prose" style="--_prose-font-body: var(--font-claude-response, var(--cds-font-voice));"><div class="_blocks_fp3b6_47 standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 whitespace-normal break-words print:block standard-markdown"><p dir="ltr">Isso mesmo, você entendeu certo — mas vale destrinchar porque tem duas coisas acontecendo ali.</p>
<h3 dir="ltr">O que o prefixo <code>assets/</code> faz</h3>
<p dir="ltr">Quando você faz upload de um arquivo no GitHub e escreve <code>assets/nome-da-imagem.png</code>, isso não é "adicionar um nome com prefixo" — é literalmente o <strong>caminho (path)</strong> do arquivo dentro do repositório. O GitHub cria automaticamente a pasta <code>assets/</code> (se ela ainda não existir) e coloca o arquivo dentro dela.</p>
<h3 dir="ltr">Como isso funciona no upload</h3>
<p dir="ltr">Na tela de <strong>Add file → Upload files</strong>, se você:</p>
<ul dir="ltr">
<li>Arrastar o arquivo e ele ficar só como <code>commit-sequencial.png</code> → ele vai pra <strong>raiz</strong> do repositório</li>
<li>Digitar/renomear para <code>assets/commit-sequencial.png</code> antes de commitar → ele vai pra dentro da pasta <code>assets/</code></li>
</ul>
<p dir="ltr">Ou seja, o <code>assets/</code> <strong>precisa</strong> estar ali na hora do upload/nome do arquivo — não é algo que "se referencia sozinho depois". Você está dizendo ao Git onde aquele arquivo deve morar na estrutura de pastas.</p>
<h3 dir="ltr">E no Markdown (<code>&lt;img src="..."&gt;</code>)</h3>
<p dir="ltr">Depois que o arquivo já está salvo em <code>assets/commit-sequencial.png</code> dentro do repositório, a tag de imagem precisa apontar pro <strong>caminho completo</strong>:</p>
<div data-not-prose=""><div role="group" aria-label="Código markdown" tabindex="0" class="relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-[var(--msg-block-radius,0.5rem)] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-100"><div class="sticky opacity-0 group-hover/copy:opacity-100 group-focus-within/copy:opacity-100 top-2 py-2 h-12 w-0 float-right"><div class="absolute right-0 h-8 px-2 items-center inline-flex z-10"><button type="button" data-cds="Button" data-cds-icon-only="" data-cds-ghost="" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus aspect-square w-control px-0 group-hover/copy:backdrop-blur-md group-focus-within/copy:backdrop-blur-md" aria-label="Copiar para a área de transferência" id="_r_23r_" data-base-ui-tooltip-trigger=""><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-initial-focus]:focus]/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-[[aria-haspopup][aria-expanded=true]]/btn:bg-fill-ghost-hover group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent "></span></span><span class="inline-flex min-w-0 items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span></span></button><span role="status" class="sr-only"></span></div></div><div class="text-text-500 font-small p-3.5 pb-0">markdown</div><div class="overflow-x-auto"><pre class="code-block__code !my-0 !rounded-[var(--msg-block-radius,0.5rem)] !text-sm !leading-relaxed p-3.5" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);"><code class="language-markdown" data-highlight="final" style="color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono); white-space: pre;"><span class="block [unicode-bidi:inherit] [text-align:-webkit-match-parent] [text-align:match-parent]" data-code-line-group=""><span>&lt;img src="assets/commit-sequencial.png" align="right" width="280"&gt;</span></span></code></pre></div></div></div>
<p dir="ltr">Se você escrever só <code>src="commit-sequencial.png"</code> (sem o <code>assets/</code>), o GitHub vai procurar o arquivo na raiz do repositório e não vai encontrar — a imagem aparece quebrada.</p>
<h3 dir="ltr">Resumindo</h3>
<div dir="ltr" class="md-table-scroll prose-scroll print:overflow-x-visible"><table><thead><tr><th scope="col" style="">Onde</th><th scope="col" style="">O que fazer</th></tr></thead><tbody><tr><td>Upload do arquivo</td><td>Nomeie/mova como <code>assets/nome.png</code> para ele cair dentro da pasta</td></tr><tr><td>Tag <code>&lt;img src="..."&gt;</code></td><td>Repita o caminho completo <code>assets/nome.png</code>, senão a imagem não é encontrada</td></tr></tbody></table></div>
<p dir="ltr">Então não é automático — você precisa escrever <code>assets/</code> <strong>nos dois lugares</strong>: na hora de subir o arquivo e na hora de referenciá-lo no Markdown.</p></div></div></div></div><div data-testid="growth-inline-line" class="flex min-h-10 items-center gap-2 rounded-[var(--msg-block-radius,0.5rem)] bg-surface-1 py-1.5 pl-3 pr-1.5 font-ui text-body text-secondary shadow-card-ring ml-[var(--msg-block-inset,0.5rem)] w-auto mt-2"><span aria-hidden="true" class="flex h-5 w-4 shrink-0 items-center justify-center [&amp;_img]:size-4"><img alt="" class="dark:hidden" src="./merge-antes_files/claude_code_desktop-icon.svg"><img alt="" class="hidden dark:block" src="./merge-antes_files/claude_code_desktop-icon-dark.svg"></span><span class="min-w-0 flex-1 break-words"><span id="claude-code-nudge-body">O Claude trabalha diretamente com sua base de código</span></span><span data-size="sm" class="flex shrink-0 items-center gap-0.5"><button type="button" data-cds="Button" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none focus-visible:outline-hidden [&amp;[data-initial-focus]:focus]:outline-hidden rounded h-control font-sans text-body [&amp;:disabled:not([aria-busy])]:opacity-disabled disabled:pointer-events-none transition-shadow duration-fast text-primary font-normal aria-pressed:text-accent focus-visible:shadow-focus [&amp;[data-initial-focus]:focus]:shadow-focus px-md" tabindex="0" aria-haspopup="menu" id="base-ui-_r_241_" aria-expanded="false"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] inset-0 cds-btn-squish"><span data-cds-part="paint" class="absolute inset-0 rounded-[inherit] transition-[background-color,box-shadow,color] duration-fast ease-out group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] group-[[data-ini